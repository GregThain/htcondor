#!/bin/bash

function usage() {
    echo "usage: $0 -prefix PREFIX -path PATH -from URL_TO_FILE -delete FILE -jobad PATH [-ignore-missing-files]"
    exit 1
}

if [[ $# -lt 8 ]]; then
    usage
fi

if [[ $1 != "-prefix" ]]; then
    usage
fi
PREFIX=$2

if [[ $3 != "-path" ]]; then
    usage
fi
LOCAL_PATH=$4

if [[ $5 != "-from" ]]; then
    usage
fi
FROM=$6

if [[ $7 != "-delete" ]]; then
    usage
fi
DELETE=$8

if [[ $9 != "-jobad" ]]; then
    usage
fi
JOB_AD=${10}

# Always tolerate a missing file: another cleanup actor (the schedd, the
# shadow, or a concurrent condor_preen) may have already removed it, and
# the post-condition we enforce is "the file is not there" — which still
# holds.  -ignore-missing-files is now redundant but accepted for callers.
if [[ ${11} == "-ignore-missing-files" ]]; then
    :
fi

FROM_REGEX="^${PREFIX}(.*)"

if [[ ${FROM} =~ ${FROM_REGEX} ]]; then
    CHECKPOINT_DIR=${BASH_REMATCH[1]}

    NO_TRAILING_SLASH_REGEX='[^/]$'
    if [[ ${CHECKPOINT_DIR} =~ $NO_TRAILING_SLASH_REGEX ]]; then
        CHECKPOINT_DIR=${CHECKPOINT_DIR}/
    fi

    if [[ ${LOCAL_PATH} =~ $NO_TRAILING_SLASH_REGEX ]]; then
        LOCAL_PATH=${LOCAL_PATH}/
    fi

    LEADING_SLASH_REGEX='^/(.*)'
    if [[ ${DELETE} =~ $LEADING_SLASH_REGEX ]]; then
        DELETE=${BASH_REMATCH[1]}
    fi

    # Delete the file.  -f makes this idempotent under concurrent cleanup.
    if ! rm -f "${LOCAL_PATH}${CHECKPOINT_DIR}${DELETE}"; then
        exit 2
    fi

    DIR="${LOCAL_PATH}${CHECKPOINT_DIR}"
    # We created directories in ${DIR} as necessary to write the
    # checkpoint, so delete them if we just removed the last file
    # in them.  This won't delete directories which didn't have
    # files in them, though.
    #
    # Each rmdir is attempted independently and silently — non-empty
    # or already-absent directories return non-zero, which is fine.
    # The previous version gated the entire chain on the existence
    # of ${DIR}${SUBDIR}, which under concurrent cleanup (shadow,
    # schedd, condor_preen) would cause every invocation but the
    # first to skip the rmdir of the global-job-ID directory.  When
    # the first invocation ran while a sibling checkpoint dir still
    # held data, the global-job-ID directory was never reclaimed.
    SUBDIR=$(dirname "${DELETE}")
    CHECKPOINT_NUMBER=$(basename "${DIR}")
    GLOBAL_JOB_ID=$(basename "$(dirname "${DIR}")")
    ( cd "${DIR}" && rmdir -p "${SUBDIR}" ) 2>/dev/null
    ( cd "${DIR}/.." && rmdir "${CHECKPOINT_NUMBER}" ) 2>/dev/null
    ( cd "${DIR}/../.." && rmdir "${GLOBAL_JOB_ID}" ) 2>/dev/null

    exit 0
else
    usage
fi
